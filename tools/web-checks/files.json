[
  { "choose": ["wedge.stl"] },
  { "click": [357, 100] },
  { "expect": "document.body.dataset.message === 'Inserted wedge (4 triangles)'", "what": "the STL inserted from the file picker" },
  { "expect": "document.body.dataset.bodies === '2'", "what": "the sample and the wedge" },

  { "choose": ["boss-on-plate.chamfera"] },
  { "key": "o", "modifiers": ["ctrl"] },
  { "expect": "document.body.dataset.message === 'Opened boss-on-plate.chamfera'", "what": "the design opened from the file picker" },
  { "expect": "document.title === 'boss-on-plate.chamfera — Chamfera'", "what": "the title names the file" },

  { "click": [58, 18] },
  { "click": [110, 203] },
  { "download": "boss-on-plate.stl", "minBytes": 134 },
  { "click": [58, 18] },
  { "click": [110, 171] },
  { "download": "boss-on-plate.step", "minBytes": 1000 },
  { "key": "s", "modifiers": ["ctrl"] },
  { "download": "boss-on-plate.chamfera", "minBytes": 1000 },
  { "expect": "document.body.dataset.message === 'Downloaded boss-on-plate.chamfera'", "what": "Save downloads the design" },

  { "expect": "(localStorage.getItem('chamfera.design') || '').includes('extrude') && localStorage.getItem('chamfera.design.name') === 'boss-on-plate.chamfera'", "what": "the design kept in local storage" },
  { "shot": "../../target/web-checks-opened.png" },

  { "reload": true },
  { "expect": "document.body.dataset.message === 'Restored boss-on-plate from this browser'", "what": "the design restored after a reload" },
  { "expect": "document.title === 'boss-on-plate.chamfera — Chamfera'", "what": "the restored design keeps its name" },
  { "shot": "../../target/web-checks-restored.png" },

  { "click": [900, 860] },
  { "key": "n", "modifiers": ["ctrl"] },
  { "expect": "localStorage.getItem('chamfera.design') === null && document.title === 'Untitled — Chamfera'", "what": "New clears local storage" },
  { "reload": true },
  { "expect": "document.title === 'Untitled — Chamfera' && document.body.dataset.bodies === '1'", "what": "after New, a reload starts with the sample again" }
]
