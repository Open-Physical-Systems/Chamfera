[
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "s1" },
  { "command": "sketch.rectangle", "params": { "x1": 0, "y1": 0, "x2": 120, "y2": 60 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$s1.sketch", "profiles": [{ "x": 60, "y": 30 }], "distance": 6 }, "as": "chassis_body" },
  { "command": "component.new", "params": { "name": "Chassis", "from_bodies": ["$chassis_body.feature"] }, "as": "chassis" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "s2" },
  { "command": "sketch.rectangle", "params": { "x1": 17, "y1": -14, "x2": 23, "y2": 74 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$s2.sketch", "profiles": [{ "x": 20, "y": 30 }], "distance": 6 }, "as": "axle_body" },
  { "command": "component.new", "params": { "name": "Axle", "from_bodies": ["$axle_body.feature"] }, "as": "axle" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "sketch.create", "params": { "plane": "xz" }, "as": "s3" },
  { "command": "sketch.circle", "params": { "cx": 20, "cy": 3, "radius": 14 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$s3.sketch", "profiles": [{ "x": 20, "y": 3 }], "distance": 6 }, "as": "wheel_body" },
  { "command": "component.new", "params": { "name": "Wheel", "from_bodies": ["$wheel_body.feature"], "parent": "$axle.component" }, "as": "wheel" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "component.move", "params": { "component": "$axle.component", "transform": { "translate": { "x": 0, "y": 0, "z": -6 } } } },
  { "command": "component.move", "params": { "component": "$wheel.component", "transform": { "translate": { "x": 0, "y": -14, "z": 0 } } } },
  { "command": "component.copy", "params": { "component": "$wheel.component", "transform": { "translate": { "x": 0, "y": 94, "z": 0 } } } },
  { "command": "component.copy", "params": { "component": "$wheel.component", "transform": { "translate": { "x": 80, "y": 0, "z": 0 } } } },
  { "command": "component.copy", "params": { "component": "$wheel.component", "transform": { "translate": { "x": 80, "y": 94, "z": 0 } } } },
  { "command": "component.copy", "params": { "component": "$axle.component", "transform": { "translate": { "x": 80, "y": 0, "z": 0 } } } },
  { "command": "body.appearance", "params": { "body": "Extrude1", "preset": "wood_oak" } },
  { "command": "body.appearance", "params": { "body": "Extrude2", "preset": "chrome" } },
  { "command": "body.appearance", "params": { "body": "Extrude3", "preset": "rubber" } },
  { "command": "view.home", "params": { "width": 1100, "height": 760 } },
  { "command": "bom.list" }
]
