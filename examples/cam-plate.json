[
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "base" },
  { "command": "sketch.rectangle", "params": { "x1": 0, "y1": 0, "x2": 100, "y2": 60 } },
  { "command": "sketch.circle", "params": { "cx": 8, "cy": 8, "radius": 3 } },
  { "command": "sketch.circle", "params": { "cx": 92, "cy": 8, "radius": 3 } },
  { "command": "sketch.circle", "params": { "cx": 92, "cy": 52, "radius": 3 } },
  { "command": "sketch.circle", "params": { "cx": 8, "cy": 52, "radius": 3 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$base.sketch", "profiles": [{ "x": 50, "y": 4 }], "distance": 12 }, "as": "plate" },
  { "command": "sketch.create_on_face", "params": { "feature": "$plate.feature", "face": "top" }, "as": "pocket" },
  { "command": "sketch.rectangle", "params": { "x1": 25, "y1": 15, "x2": 75, "y2": 45 } },
  { "command": "sketch.circle", "params": { "cx": 50, "cy": 30, "radius": 6 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$pocket.sketch", "profiles": [{ "x": 30, "y": 20 }], "distance": 5, "direction": "reversed", "operation": "cut" }, "as": "cut" },
  { "command": "cam.setup", "params": { "stock": { "kind": "from_model", "side": 3, "top": 1, "bottom": 0 }, "origin": "stock_top_corner" } },
  { "command": "cam.tool_add", "params": { "kind": "flat_end_mill", "diameter": 12, "feed": 900 }, "as": "face_mill" },
  { "command": "cam.tool_add", "params": { "kind": "flat_end_mill", "diameter": 6, "feed": 600 }, "as": "mill" },
  { "command": "cam.tool_add", "params": { "kind": "drill", "diameter": 5, "feed": 150, "plunge_feed": 100 }, "as": "drill" },
  { "command": "cam.op_add", "params": { "kind": "facing", "tool": "$face_mill.tool", "stepover": 60, "stepdown": 1 } },
  { "command": "cam.op_add", "params": { "kind": "pocket", "tool": "$mill.tool", "face": "4:top", "stepover": 45, "stepdown": 2.5 } },
  { "command": "cam.op_add", "params": { "kind": "drill", "tool": "$drill.tool", "peck": 3, "breakthrough": 1 } },
  { "command": "cam.op_add", "params": { "kind": "contour", "tool": "$mill.tool", "face": "2:bottom", "side": "outside", "stepdown": 4, "bottom_offset": 0.5 } },
  { "command": "cam.generate" },
  { "command": "view.home", "params": { "width": 1100, "height": 760 } }
]
