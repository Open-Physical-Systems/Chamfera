[
  { "command": "param.set", "params": { "name": "thickness", "expression": "10 mm" } },
  { "command": "param.set", "params": { "name": "bolt", "expression": "6.6 mm" } },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "base" },
  { "command": "sketch.rectangle", "params": { "x1": 0, "y1": 0, "x2": 80, "y2": 50 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$base.sketch", "profiles": [{ "x": 5, "y": 5 }], "distance": "thickness" }, "as": "plate" },
  { "command": "sketch.create_on_face", "params": { "feature": "$plate.feature", "face": "top" }, "as": "corners" },
  { "command": "sketch.point", "params": { "x": 10, "y": 10 } },
  { "command": "sketch.point", "params": { "x": 70, "y": 10 } },
  { "command": "sketch.point", "params": { "x": 70, "y": 40 } },
  { "command": "sketch.point", "params": { "x": 10, "y": 40 } },
  { "command": "sketch.finish" },
  { "command": "solid.hole", "params": { "face": "2:top", "sketch": "$corners.sketch", "kind": "counterbore", "diameter": "bolt", "through_all": true, "cb_diameter": "bolt * 1.7", "cb_depth": "thickness * 0.4" } },
  { "command": "solid.hole", "params": { "face": "2:top", "points": [{ "x": 40, "y": 25 }], "kind": "countersink", "diameter": 6, "through_all": true, "cs_diameter": 12, "cs_angle": 90 } },
  { "command": "solid.hole", "params": { "face": "2:top", "points": [{ "x": 25, "y": 25 }, { "x": 55, "y": 25 }], "diameter": 5, "depth": 6 } },
  { "command": "drawing.new_sheet", "params": { "paper": "a3", "scale": 2 } },
  { "command": "drawing.edit_sheet", "params": { "part_name": "Hole plate", "drawing_number": "CH-0101", "revision": "A", "material": "AlMg3", "drawn_by": "Chamfera", "checked_by": "QA" } },
  { "command": "drawing.add_view", "params": { "view": "front", "x": 130, "y": 95 }, "as": "front" },
  { "command": "drawing.add_view", "params": { "view": "top", "x": 130, "y": 190 }, "as": "top" },
  { "command": "drawing.add_section", "params": { "view": "$top.view", "x1": 215, "y1": 190, "x2": 45, "y2": 190, "x": 320, "y": 95 } },
  { "command": "drawing.add_ordinate", "params": { "view": "$top.view", "axis": "x", "x0": 50, "y0": 140, "points": [{ "x": 70, "y": 160 }, { "x": 100, "y": 190 }, { "x": 130, "y": 190 }, { "x": 160, "y": 190 }, { "x": 190, "y": 160 }, { "x": 210, "y": 140 }] } },
  { "command": "drawing.add_ordinate", "params": { "view": "$top.view", "axis": "y", "x0": 50, "y0": 140, "offset": -18, "points": [{ "x": 70, "y": 160 }, { "x": 130, "y": 190 }, { "x": 70, "y": 220 }, { "x": 50, "y": 240 }] } },
  { "command": "drawing.add_chain", "params": { "view": "$top.view", "kind": "horizontal", "points": [{ "x": 50, "y": 240 }, { "x": 70, "y": 220 }, { "x": 190, "y": 220 }, { "x": 210, "y": 240 }] } },
  { "command": "drawing.add_dimension", "params": { "view": "$front.view", "kind": "vertical", "x1": 210, "y1": 85, "x2": 210, "y2": 105, "offset": 8 } },
  { "command": "drawing.add_hole_callout", "params": { "view": "$top.view", "x1": 81.22, "y1": 220, "x": 96, "y": 272 } },
  { "command": "drawing.add_hole_callout", "params": { "view": "$top.view", "x1": 142, "y1": 190, "x": 178, "y": 272 } },
  { "command": "drawing.add_hole_callout", "params": { "view": "$top.view", "x1": 165, "y1": 190, "x": 222, "y": 262 } }
