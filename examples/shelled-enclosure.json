[
  { "command": "param.set", "params": { "name": "wall", "expression": "2 mm" } },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "s" },
  { "command": "sketch.rectangle", "params": { "x1": 0, "y1": 0, "x2": 80, "y2": 50 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$s.sketch", "profiles": [{ "x": 5, "y": 5 }], "distance": 30 } },
  { "command": "solid.fillet", "params": { "edges": ["2:sweep 0", "2:sweep 1", "2:sweep 2", "2:sweep 3"], "radius": 8 } },
  { "command": "solid.shell", "params": { "faces": ["2:top"], "thickness": "wall" } },
  { "command": "view.home", "params": { "width": 1100, "height": 760 } }
]
