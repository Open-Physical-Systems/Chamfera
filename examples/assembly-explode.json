[
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "s1" },
  { "command": "sketch.rectangle", "params": { "x1": 0, "y1": 0, "x2": 60, "y2": 40 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$s1.sketch", "profiles": [{ "x": 30, "y": 20 }], "distance": 6 }, "as": "f1" },
  { "command": "component.new", "params": { "name": "Base", "from_bodies": ["$f1.feature"] }, "as": "base" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "s2" },
  { "command": "sketch.rectangle", "params": { "x1": 4, "y1": 10, "x2": 24, "y2": 30 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$s2.sketch", "profiles": [{ "x": 14, "y": 20 }], "distance": 15 }, "as": "f2" },
  { "command": "component.new", "params": { "name": "Left block", "from_bodies": ["$f2.feature"] }, "as": "left" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "s3" },
  { "command": "sketch.circle", "params": { "cx": 46, "cy": 20, "radius": 9 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$s3.sketch", "profiles": [{ "x": 46, "y": 20 }], "distance": 12 }, "as": "f3" },
  { "command": "component.new", "params": { "name": "Pin", "from_bodies": ["$f3.feature"] }, "as": "pin" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "component.move", "params": { "component": "$left.component", "transform": { "translate": { "x": 0, "y": 0, "z": 6 } } } },
  { "command": "component.move", "params": { "component": "$pin.component", "transform": { "translate": { "x": 0, "y": 0, "z": 6 } } } },
  { "command": "component.ground", "params": { "component": "$base.component" } },
  { "command": "component.tint", "params": { "component": "$base.component", "tint": true } },
  { "command": "component.tint", "params": { "component": "$left.component", "tint": true } },
  { "command": "component.tint", "params": { "component": "$pin.component", "tint": true } },
  { "command": "view.explode", "params": { "factor": 2.5 } },
  { "command": "view.explode", "params": { "component": "$pin.component", "offset": { "x": 0, "y": 0, "z": 20 } } },
  { "command": "view.home", "params": { "width": 1100, "height": 760 } }
]
