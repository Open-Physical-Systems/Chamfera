[
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "s1" },
  { "command": "sketch.slot", "params": { "x1": 0, "y1": 0, "x2": 100, "y2": 0, "width": 16 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$s1.sketch", "profiles": [{ "x": 50, "y": 0 }], "distance": 4 }, "as": "f1" },
  { "command": "component.new", "params": { "name": "Ground", "from_bodies": ["$f1.feature"] }, "as": "ground" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "s2" },
  { "command": "sketch.slot", "params": { "x1": 0, "y1": 0, "x2": 40, "y2": 0, "width": 10 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$s2.sketch", "profiles": [{ "x": 20, "y": 0 }], "distance": 4 }, "as": "f2" },
  { "command": "component.new", "params": { "name": "Crank", "from_bodies": ["$f2.feature"] }, "as": "crank" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "s3" },
  { "command": "sketch.slot", "params": { "x1": 0, "y1": 0, "x2": 120, "y2": 0, "width": 10 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$s3.sketch", "profiles": [{ "x": 60, "y": 0 }], "distance": 4 }, "as": "f3" },
  { "command": "component.new", "params": { "name": "Coupler", "from_bodies": ["$f3.feature"] }, "as": "coupler" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "s4" },
  { "command": "sketch.slot", "params": { "x1": 0, "y1": 0, "x2": 80, "y2": 0, "width": 10 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$s4.sketch", "profiles": [{ "x": 40, "y": 0 }], "distance": 4 }, "as": "f4" },
  { "command": "component.new", "params": { "name": "Rocker", "from_bodies": ["$f4.feature"] }, "as": "rocker" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "component.ground", "params": { "component": "$ground.component" } },
  { "command": "joint.create", "params": { "type": "revolute", "name": "Crank pivot", "value": 90,
      "a": { "component": "$ground.component", "point": { "x": 0, "y": 0, "z": 4 }, "axis": { "x": 0, "y": 0, "z": 1 } },
      "b": { "component": "$crank.component", "point": { "x": 0, "y": 0, "z": 0 }, "axis": { "x": 0, "y": 0, "z": 1 } } }, "as": "input" },
  { "command": "joint.create", "params": { "type": "revolute", "name": "Crank pin", "value": -71,
      "a": { "component": "$crank.component", "point": { "x": 40, "y": 0, "z": 4 }, "axis": { "x": 0, "y": 0, "z": 1 } },
      "b": { "component": "$coupler.component", "point": { "x": 0, "y": 0, "z": 0 }, "axis": { "x": 0, "y": 0, "z": 1 } } } },
  { "command": "joint.create", "params": { "type": "revolute", "name": "Rocker pin", "value": 61,
      "a": { "component": "$coupler.component", "point": { "x": 120, "y": 0, "z": 0 }, "axis": { "x": 0, "y": 0, "z": 1 } },
      "b": { "component": "$rocker.component", "point": { "x": 80, "y": 0, "z": 4 }, "axis": { "x": 0, "y": 0, "z": 1 } } } },
  { "command": "joint.create", "params": { "type": "revolute", "name": "Rocker pivot", "value": 80,
      "a": { "component": "$ground.component", "point": { "x": 100, "y": 0, "z": 4 }, "axis": { "x": 0, "y": 0, "z": 1 } },
      "b": { "component": "$rocker.component", "point": { "x": 0, "y": 0, "z": 0 }, "axis": { "x": 0, "y": 0, "z": 1 } } } },
  { "command": "joint.set_value", "params": { "joint": "$input.joint", "value": 60 } },
  { "command": "component.tint", "params": { "component": "$ground.component", "tint": true } },
  { "command": "component.tint", "params": { "component": "$crank.component", "tint": true } },
  { "command": "component.tint", "params": { "component": "$coupler.component", "tint": true } },
  { "command": "component.tint", "params": { "component": "$rocker.component", "tint": true } },
  { "command": "view.standard", "params": { "view": "top" } },
  { "command": "view.fit", "params": { "width": 1100, "height": 760 } }
]
