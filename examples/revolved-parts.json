[
  { "command": "sketch.create", "params": { "plane": "xz" }, "as": "sketch" },
  { "command": "sketch.rectangle", "params": { "x1": 10, "y1": 0, "x2": 15, "y2": 20 } },
  { "command": "sketch.circle", "params": { "cx": 30, "cy": 10, "radius": 5 } },
  { "command": "sketch.line", "params": { "x1": 0, "y1": -5, "x2": 0, "y2": 25 }, "as": "axis" },
  { "command": "sketch.construction", "params": { "curve": "$axis.curve", "construction": true } },
  { "command": "sketch.finish" },
  { "command": "solid.revolve", "params": { "sketch": "$sketch.sketch", "profiles": [{ "x": 12, "y": 10 }, { "x": 30, "y": 10 }], "axis": "$axis.curve", "angle": 360 } },
  { "command": "view.home", "params": { "width": 1100, "height": 760 } }
]
