[
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "base" },
  { "command": "sketch.rectangle", "params": { "x1": 0, "y1": 0, "x2": 40, "y2": 20 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$base.sketch", "profiles": [{ "x": 20, "y": 10 }], "distance": 10 } },
  { "command": "solid.draft", "params": { "faces": ["2:side 0", "2:side 1", "2:side 2", "2:side 3"], "neutral": "2:bottom", "angle": "5 deg" } },
  { "command": "view.home", "params": { "width": 1100, "height": 760 } }
]
