[
  { "command": "component.new", "params": { "name": "Leaf A" }, "as": "a" },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "sa" },
  { "command": "sketch.rectangle", "params": { "x1": 2, "y1": 0, "x2": 42, "y2": 30 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$sa.sketch", "profiles": [{ "x": 20, "y": 15 }], "distance": 3 }, "as": "leafa" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "component.new", "params": { "name": "Leaf B" }, "as": "b" },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "sb" },
  { "command": "sketch.rectangle", "params": { "x1": -42, "y1": 0, "x2": -2, "y2": 30 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$sb.sketch", "profiles": [{ "x": -20, "y": 15 }], "distance": 3 }, "as": "leafb" },
  { "command": "component.activate", "params": { "component": 0 } },
  { "command": "component.ground", "params": { "component": "$a.component" } },
  { "command": "component.tint", "params": { "component": "$a.component", "tint": true } },
  { "command": "component.tint", "params": { "component": "$b.component", "tint": true } },
  { "command": "joint.create", "params": {
      "type": "revolute", "name": "Hinge",
      "a": { "component": "$a.component", "point": { "x": 0, "y": 0, "z": 1.5 }, "axis": { "x": 0, "y": 1, "z": 0 } },
      "b": { "component": "$b.component", "point": { "x": 0, "y": 0, "z": 1.5 }, "axis": { "x": 0, "y": 1, "z": 0 } },
      "value": 0, "min": 0, "max": 180 }, "as": "hinge" },
  { "command": "inspect.measure", "params": { "a": { "solid": "$leafa.name" }, "b": { "solid": "$leafb.name" } }, "as": "d0" },
  { "command": "joint.set_value", "params": { "joint": "$hinge.joint", "value": 45 } },
  { "command": "inspect.measure", "params": { "a": { "solid": "$leafa.name" }, "b": { "solid": "$leafb.name" } }, "as": "d45" },
  { "command": "joint.set_value", "params": { "joint": "$hinge.joint", "value": 90 } },
  { "command": "inspect.measure", "params": { "a": { "solid": "$leafa.name" }, "b": { "solid": "$leafb.name" } }, "as": "d90" },
  { "command": "component.list" },
  { "command": "view.home", "params": { "width": 1600, "height": 950 } }
]
