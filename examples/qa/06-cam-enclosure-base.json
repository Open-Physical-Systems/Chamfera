[
  { "command": "design.open", "params": { "path": "target/qa/01-enclosure.chamfera" } },
  { "command": "solid.remove", "params": { "bodies": ["Extrude2"] } },
  { "command": "solid.hole", "params": { "face": "4:shell of 2:bottom", "points": [{ "x": 15, "y": 15 }, { "x": 65, "y": 15 }, { "x": 65, "y": 35 }, { "x": 15, "y": 35 }], "diameter": 4, "through_all": true }, "as": "vents" },
  { "command": "cam.setup", "params": { "name": "Base", "stock": { "kind": "from_model", "side": 3, "top": 1, "bottom": 0 }, "origin": "stock_top_corner" } },
