  { "command": "cam.tool_add", "params": { "kind": "flat_end_mill", "diameter": 6, "feed": 600 }, "as": "mill" },
  { "command": "cam.tool_add", "params": { "kind": "drill", "diameter": 4, "feed": 150, "plunge_feed": 100 }, "as": "drill" },
