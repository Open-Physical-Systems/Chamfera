[
  { "command": "param.set", "params": { "name": "bolts", "expression": "6", "unit": "unitless" } },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "fl" },
  { "command": "sketch.circle", "params": { "cx": 0, "cy": 0, "radius": 40 } },
  { "command": "sketch.circle", "params": { "cx": 0, "cy": 0, "radius": 15 } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$fl.sketch", "profiles": [{ "x": 25, "y": 0 }], "distance": 8 }, "as": "flange" },
  { "command": "sketch.create", "params": { "plane": "xy", "offset": 8 }, "as": "o0" },
  { "command": "sketch.circle", "params": { "cx": 0, "cy": 0, "radius": 20 } },
  { "command": "sketch.finish" },
  { "command": "sketch.create", "params": { "plane": "xy", "offset": 28 }, "as": "o1" },
  { "command": "sketch.circle", "params": { "cx": 0, "cy": 0, "radius": 12.5 } },
  { "command": "sketch.finish" },
  { "command": "solid.loft", "params": { "sections": [{ "sketch": "$o0.sketch", "x": 0, "y": 0 }, { "sketch": "$o1.sketch", "x": 0, "y": 0 }], "operation": "join" }, "as": "loft" },
  { "command": "sketch.create", "params": { "plane": "xy", "offset": 8 }, "as": "i0" },
  { "command": "sketch.circle", "params": { "cx": 0, "cy": 0, "radius": 15 } },
  { "command": "sketch.finish" },
  { "command": "sketch.create", "params": { "plane": "xy", "offset": 28 }, "as": "i1" },
  { "command": "sketch.circle", "params": { "cx": 0, "cy": 0, "radius": 10 } },
  { "command": "sketch.finish" },
  { "command": "solid.loft", "params": { "sections": [{ "sketch": "$i0.sketch", "x": 0, "y": 0 }, { "sketch": "$i1.sketch", "x": 0, "y": 0 }], "operation": "cut" }, "as": "bore" },
  { "command": "sketch.create", "params": { "plane": "xy", "offset": 28 }, "as": "l1" },
  { "command": "sketch.circle", "params": { "cx": 0, "cy": 0, "radius": 12.5 } },
  { "command": "sketch.circle", "params": { "cx": 0, "cy": 0, "radius": 10 } },
  { "command": "sketch.finish" },
  { "command": "sketch.create", "params": { "plane": "xz" }, "as": "path" },
  { "command": "sketch.line", "params": { "x1": 0, "y1": 28, "x2": 0, "y2": 78 }, "as": "up" },
  { "command": "sketch.arc", "params": { "cx": 30, "cy": 78, "x1": 30, "y1": 108, "x2": 0, "y2": 78 }, "as": "bend" },
  { "command": "sketch.line", "params": { "x1": 30, "y1": 108, "x2": 80, "y2": 108 }, "as": "run" },
  { "command": "sketch.finish" },
  { "command": "solid.sweep", "params": { "sketch": "$l1.sketch", "profiles": [{ "x": 11, "y": 0 }], "path_sketch": "$path.sketch", "path_curves": ["$up.curve", "$bend.curve", "$run.curve"], "operation": "join" }, "as": "pipe" },
  { "command": "solid.hole", "params": { "face": "2:top", "points": [{ "x": 30, "y": 0 }], "diameter": 7, "through_all": true }, "as": "hole" },
  { "command": "solid.pattern_circular", "params": { "feature": "$hole.feature", "count": "bolts", "origin": { "x": 0, "y": 0, "z": 0 }, "axis": { "x": 0, "y": 0, "z": 1 } }, "as": "bolt_pattern" },
  { "command": "solid.chamfer", "params": { "edges": ["2:top 0"], "distance": 1 }, "as": "rim" },
  { "command": "view.home", "params": { "width": 1600, "height": 950 } }
]
