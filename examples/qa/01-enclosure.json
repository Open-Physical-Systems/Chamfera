[
  { "command": "param.set", "params": { "name": "width", "expression": "80 mm" } },
  { "command": "param.set", "params": { "name": "depth", "expression": "50 mm" } },
  { "command": "param.set", "params": { "name": "height", "expression": "30 mm" } },
  { "command": "param.set", "params": { "name": "wall", "expression": "2 mm" } },
  { "command": "param.set", "params": { "name": "corner", "expression": "6 mm" } },
  { "command": "param.set", "params": { "name": "gap", "expression": "5 mm" } },
  { "command": "param.set", "params": { "name": "lid", "expression": "3 mm" } },
  { "command": "param.set", "params": { "name": "inset", "expression": "6 mm" } },
  { "command": "sketch.create", "params": { "plane": "xy" }, "as": "base" },
  { "command": "sketch.rectangle", "params": { "x1": 0, "y1": 0, "x2": 80, "y2": 50 }, "as": "r" },
  { "command": "sketch.constrain", "params": { "constraint": { "kind": "fix", "point": "$r.points.0", "at": { "x": 0, "y": 0 } } } },
  { "command": "sketch.constrain", "params": { "constraint": { "kind": "length", "line": "$r.curves.0", "value": 80 } }, "as": "dw" },
  { "command": "sketch.constrain", "params": { "constraint": { "kind": "length", "line": "$r.curves.1", "value": 50 } }, "as": "dd" },
  { "command": "sketch.dimension", "params": { "constraint": "$dw.constraint", "expression": "width" } },
  { "command": "sketch.dimension", "params": { "constraint": "$dd.constraint", "expression": "depth" } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$base.sketch", "profiles": [{ "x": 5, "y": 5 }], "distance": "height" }, "as": "box" },
  { "command": "solid.fillet", "params": { "edges": ["2:sweep 0", "2:sweep 1", "2:sweep 2", "2:sweep 3"], "radius": "corner" }, "as": "fillet" },
  { "command": "solid.shell", "params": { "faces": ["2:top"], "thickness": "wall" }, "as": "shell" },
  { "command": "construct.plane_offset", "params": { "base": "xy", "distance": "height + gap" }, "as": "plane" },
  { "command": "sketch.create", "params": { "plane": "$plane.feature" }, "as": "lidsk" },
  { "command": "sketch.rectangle", "params": { "x1": 0, "y1": 0, "x2": 80, "y2": 50 }, "as": "lr" },
  { "command": "sketch.constrain", "params": { "constraint": { "kind": "fix", "point": "$lr.points.0", "at": { "x": 0, "y": 0 } } } },
  { "command": "sketch.constrain", "params": { "constraint": { "kind": "length", "line": "$lr.curves.0", "value": 80 } }, "as": "lw" },
  { "command": "sketch.constrain", "params": { "constraint": { "kind": "length", "line": "$lr.curves.1", "value": 50 } }, "as": "ld" },
  { "command": "sketch.dimension", "params": { "constraint": "$lw.constraint", "expression": "width" } },
  { "command": "sketch.dimension", "params": { "constraint": "$ld.constraint", "expression": "depth" } },
  { "command": "sketch.finish" },
  { "command": "solid.extrude", "params": { "sketch": "$lidsk.sketch", "profiles": [{ "x": 5, "y": 5 }], "distance": "lid" }, "as": "lidbody" },
  { "command": "sketch.create_on_face", "params": { "feature": "$lidbody.feature", "face": "top" }, "as": "hs" },
  { "command": "sketch.point", "params": { "x": 6, "y": 6 }, "as": "p1" },
  { "command": "sketch.point", "params": { "x": 6, "y": 44 }, "as": "p2" },
  { "command": "sketch.line", "params": { "x1": 6, "y1": 0, "x2": 6, "y2": 50 }, "as": "axis" },
  { "command": "sketch.construction", "params": { "curve": "$axis.curve", "construction": true } },
  { "command": "sketch.constrain", "params": { "constraints": [
    { "kind": "vertical", "line": "$axis.curve" },
    { "kind": "fix", "point": "$axis.start", "at": { "x": 6, "y": 0 } },
    { "kind": "fix", "point": "$p1.point", "at": { "x": 6, "y": 6 } },
    { "kind": "point_on_line", "point": "$p2.point", "line": "$axis.curve" } ] } },
  { "command": "sketch.constrain", "params": { "constraint": { "kind": "distance", "a": "$p1.point", "b": "$p2.point", "value": 38 } }, "as": "sp" },
  { "command": "sketch.dimension", "params": { "constraint": "$sp.constraint", "expression": "depth - 2 * inset" } },
  { "command": "sketch.constrain", "params": { "constraint": { "kind": "length", "line": "$axis.curve", "value": 50 } }, "as": "al" },
  { "command": "sketch.dimension", "params": { "constraint": "$al.constraint", "expression": "depth" } },
  { "command": "sketch.get", "as": "hsg" },
  { "command": "sketch.finish" },
  { "command": "solid.hole", "params": { "face": "7:top", "sketch": "$hs.sketch", "kind": "counterbore", "diameter": 3.4, "through_all": true, "cb_diameter": 6.5, "cb_depth": 1.5 }, "as": "hole" },
  { "command": "solid.pattern_linear", "params": { "feature": "$hole.feature", "count": 2, "direction": { "x": 1, "y": 0, "z": 0 }, "spacing": "width - 2 * inset" }, "as": "px" },
  { "command": "design.save", "params": { "path": "target/qa/01-enclosure.chamfera" } },
  { "command": "view.home", "params": { "width": 1600, "height": 950 } }
]
